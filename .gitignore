# Local .terraform directories
**/.terraform/*

# .tfstate files - contain resource details and can include sensitive data
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files, generally used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file - see note below on whether to commit this
# .terraform.lock.hcl

# Ignore any .tfvars files that contain sensitive data
# Uncomment if you separate secrets from terraform.tfvars
# *.auto.tfvars

# OS/editor files
.DS_Store
.vscode/*
!.vscode/settings.json
